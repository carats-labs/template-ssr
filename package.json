{
  "name": "vite-jjsx-ssr",
  "private": true,
  "version": "0.0.5",
  "type": "module",
  "scripts": {
    "dev": "bun --inspect=6499 src/app.ts",
    "start": "cross-env NODE_ENV=production bun --inspect=6499 src/app.ts",
    "build": "bun build:server && bun build:client",
    "build:client": "vite build --config vite.config.client.ts",
    "build:server": "vite build --config vite.config.server.ts",
    "build:static": "cross-env NODE_ENV=production carats-ssg",
    "preview": "cross-env NODE_ENV=production bun dist/app.js",
    "test": "vitest --run --coverage"
  },
  "dependencies": {
    "@carats/core": "^0.0.16",
    "@carats/csr": "^0.0.33",
    "@carats/express": "^0.0.19",
    "@carats/hooks": "^0.0.5",
    "@carats/render": "^0.0.19",
    "@carats/ssg": "^0.0.9",
    "@carats/ssr": "^0.0.29",
    "compression": "^1.8.2",
    "express": "^5.3.0",
    "jjsx": "^5.0.0",
    "sass-embedded": "^1.108.1",
    "sirv": "^3.0.2"
  },
  "devDependencies": {
    "@fetch-mock/vitest": "^0.2.18",
    "@types/bun": "^1.4.4",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@vitest/coverage-v8": "4.0.18",
    "cross-env": "^10.1.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.7",
    "vitest": "^4.1.12"
  }
}